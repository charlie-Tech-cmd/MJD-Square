APP_ENV=development
DATABASE_URL=sqlite:///./data/mjd_square.db
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# Password recovery email (configure with your SMTP provider)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
MAIL_FROM=

# Private S3-compatible storage for uploaded payment receipts (production required)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers such as R2 or MinIO
S3_ENDPOINT_URL=
