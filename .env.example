APP_ENV=development
DATABASE_URL=sqlite:///./data/mjd_square.db
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# Password recovery email. For Brevo, use the SMTP login and SMTP key (not API key).
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
MAIL_FROM=

# Private S3-compatible storage for uploaded payment receipts (production required)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers such as R2 or MinIO
S3_ENDPOINT_URL=

# Optional automatic WhatsApp payment receipts (Meta WhatsApp Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_RECEIPT_TEMPLATE=
WHATSAPP_RECEIPT_TEMPLATE_LANGUAGE=en
# Configure these together to verify Meta webhook delivery-status callbacks
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
