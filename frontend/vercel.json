{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mjd-square-vercel.vercel.app/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://mjd-square-vercel.vercel.app/health/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
